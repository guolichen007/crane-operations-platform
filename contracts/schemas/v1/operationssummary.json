{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.invalid/crane/v1/operationssummary.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sampledAt",
    "generatedAt",
    "scope",
    "freshness",
    "metrics",
    "regions"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "sampledAt": {
      "type": "string",
      "format": "date-time"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "scope": {
      "$ref": "#/$defs/OperationsScope"
    },
    "freshness": {
      "$ref": "#/$defs/OperationsFreshness"
    },
    "metrics": {
      "$ref": "#/$defs/OperationsMetrics"
    },
    "regions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/OperationsRegion"
      }
    }
  },
  "$defs": {
    "OperationsScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "region",
        "regionName",
        "authorizedProjects",
        "geoIndexVersion"
      ],
      "properties": {
        "region": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 100000,
              "maximum": 999999
            },
            {
              "type": "null"
            }
          ]
        },
        "regionName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "authorizedProjects": {
          "type": "integer",
          "minimum": 0
        },
        "geoIndexVersion": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "OperationsFreshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "staleAfterSeconds",
        "maxFutureSkewSeconds",
        "alarmWindow",
        "windowStart",
        "windowEnd"
      ],
      "properties": {
        "staleAfterSeconds": {
          "type": "integer",
          "minimum": 300,
          "maximum": 7200
        },
        "maxFutureSkewSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600
        },
        "alarmWindow": {
          "type": "string",
          "enum": [
            "PT1H",
            "PT6H",
            "PT24H",
            "P7D"
          ]
        },
        "windowStart": {
          "type": "string",
          "format": "date-time"
        },
        "windowEnd": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "OperationsMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projects",
        "assets",
        "bound",
        "real",
        "operation",
        "alarm",
        "pendingEvents"
      ],
      "properties": {
        "projects": {
          "type": "integer",
          "minimum": 0
        },
        "assets": {
          "$ref": "#/$defs/OperationsAssetCounts"
        },
        "bound": {
          "$ref": "#/$defs/RuntimeSourceCounts"
        },
        "real": {
          "$ref": "#/$defs/OperationsRealCounts"
        },
        "operation": {
          "$ref": "#/$defs/NotAvailable"
        },
        "alarm": {
          "$ref": "#/$defs/OperationsAlarmCounts"
        },
        "pendingEvents": {
          "$ref": "#/$defs/NotAvailable"
        }
      }
    },
    "OperationsAssetCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registered",
        "draft",
        "outOfService",
        "noRuntime",
        "unlocated",
        "atScopeLevel"
      ],
      "properties": {
        "registered": {
          "type": "integer",
          "minimum": 0
        },
        "draft": {
          "type": "integer",
          "minimum": 0
        },
        "outOfService": {
          "type": "integer",
          "minimum": 0
        },
        "noRuntime": {
          "type": "integer",
          "minimum": 0
        },
        "unlocated": {
          "type": "integer",
          "minimum": 0
        },
        "atScopeLevel": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "RuntimeSourceCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "REAL",
        "SIMULATION",
        "TEST"
      ],
      "properties": {
        "REAL": {
          "type": "integer",
          "minimum": 0
        },
        "SIMULATION": {
          "type": "integer",
          "minimum": 0
        },
        "TEST": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "OperationsRealCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "connected",
        "pendingReview",
        "pendingReviewAlarm",
        "pendingReviewAssets",
        "stale",
        "unknownTime",
        "offline",
        "live"
      ],
      "properties": {
        "connected": {
          "type": "integer",
          "minimum": 0
        },
        "pendingReview": {
          "type": "integer",
          "minimum": 0
        },
        "pendingReviewAlarm": {
          "type": "integer",
          "minimum": 0
        },
        "pendingReviewAssets": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/OperationsReviewAsset"
          }
        },
        "stale": {
          "type": "integer",
          "minimum": 0
        },
        "unknownTime": {
          "type": "integer",
          "minimum": 0
        },
        "offline": {
          "type": "integer",
          "minimum": 0
        },
        "live": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "OperationsReviewAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "assetStatus",
        "alarm"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,80}$"
        },
        "assetStatus": {
          "type": "string",
          "enum": [
            "DRAFT",
            "OUT_OF_SERVICE"
          ]
        },
        "alarm": {
          "type": "boolean"
        }
      }
    },
    "NotAvailable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "NOT_AVAILABLE"
          ]
        }
      }
    },
    "OperationsAlarmCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "devices",
        "devicesAll",
        "records"
      ],
      "properties": {
        "devices": {
          "$ref": "#/$defs/RuntimeSourceCounts"
        },
        "devicesAll": {
          "type": "integer",
          "minimum": 0
        },
        "records": {
          "$ref": "#/$defs/OperationsAlarmRecords"
        }
      }
    },
    "OperationsAlarmRecords": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cells",
        "total",
        "assets",
        "futureSkew"
      ],
      "properties": {
        "cells": {
          "$ref": "#/$defs/OperationsAlarmCells"
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "assets": {
          "type": "integer",
          "minimum": 0
        },
        "futureSkew": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "OperationsAlarmCells": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "REAL",
        "SIMULATION",
        "TEST"
      ],
      "properties": {
        "REAL": {
          "$ref": "#/$defs/AlarmAttributionCell"
        },
        "SIMULATION": {
          "$ref": "#/$defs/AlarmAttributionCell"
        },
        "TEST": {
          "$ref": "#/$defs/AlarmAttributionCell"
        }
      }
    },
    "AlarmAttributionCell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attributed",
        "unattributed"
      ],
      "properties": {
        "attributed": {
          "type": "integer",
          "minimum": 0
        },
        "unattributed": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "OperationsRegion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adcode",
        "name",
        "registered",
        "realConnected",
        "realAlarmDevices"
      ],
      "properties": {
        "adcode": {
          "type": "integer",
          "minimum": 100000,
          "maximum": 999999
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "registered": {
          "type": "integer",
          "minimum": 0
        },
        "realConnected": {
          "type": "integer",
          "minimum": 0
        },
        "realAlarmDevices": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
