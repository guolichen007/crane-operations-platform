{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.invalid/crane/v1/portfolioscope.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "tenantId",
    "code",
    "name",
    "status",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "tenantId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "code": {
      "type": "string",
      "maxLength": 80
    },
    "name": {
      "type": "string",
      "maxLength": 160
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "DISABLED"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    }
  },
  "$defs": {}
}
