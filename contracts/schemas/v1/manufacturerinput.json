{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.invalid/crane/v1/manufacturerinput.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "projectId",
    "name",
    "shortName",
    "countryRegion",
    "website"
  ],
  "properties": {
    "projectId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,80}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "name": {
      "type": "string",
      "maxLength": 256
    },
    "shortName": {
      "type": "string",
      "maxLength": 160
    },
    "countryRegion": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 80
        },
        {
          "type": "null"
        }
      ]
    },
    "website": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 256
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {}
}
