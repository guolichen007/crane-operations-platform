{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.invalid/crane/v1/projectgrant.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "projectId",
    "projectName",
    "role"
  ],
  "properties": {
    "projectId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "projectName": {
      "type": "string",
      "maxLength": 256
    },
    "role": {
      "type": "string",
      "enum": [
        "viewer",
        "operator",
        "maintainer",
        "platform_admin"
      ]
    }
  },
  "$defs": {}
}
