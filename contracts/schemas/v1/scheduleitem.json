{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.invalid/crane/v1/scheduleitem.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "projectId",
    "sourceType",
    "sourceId",
    "name",
    "startAt",
    "endAt",
    "timezone",
    "status",
    "priority",
    "exclusiveLocationId",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "projectId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,80}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "sourceType": {
      "type": "string",
      "enum": [
        "PROJECT_ACTIVITY",
        "WORK_ORDER",
        "INSPECTION",
        "CALIBRATION",
        "COMMISSIONING",
        "SITE_WINDOW",
        "NETWORK_CUTOVER"
      ]
    },
    "sourceId": {
      "type": "string",
      "maxLength": 80
    },
    "name": {
      "type": "string",
      "maxLength": 160
    },
    "startAt": {
      "type": "string",
      "format": "date-time"
    },
    "endAt": {
      "type": "string",
      "format": "date-time"
    },
    "timezone": {
      "type": "string",
      "maxLength": 80
    },
    "status": {
      "type": "string",
      "enum": [
        "PLANNED",
        "APPROVED",
        "IN_PROGRESS",
        "COMPLETED",
        "CANCELLED"
      ]
    },
    "priority": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    },
    "exclusiveLocationId": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 80
        },
        {
          "type": "null"
        }
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    }
  },
  "$defs": {}
}
