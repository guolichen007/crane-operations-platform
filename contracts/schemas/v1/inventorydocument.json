{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.invalid/crane/v1/inventorydocument.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenantId",
    "projects",
    "assetDevices",
    "runtimeDevices"
  ],
  "properties": {
    "tenantId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "projects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/InventoryProjectInput"
      }
    },
    "assetDevices": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/InventoryAssetInput"
      }
    },
    "runtimeDevices": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RuntimeDescriptor"
      }
    }
  },
  "$defs": {
    "InventoryProjectInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "lifecycle",
        "province",
        "city",
        "county",
        "locationLabel",
        "adminCode",
        "scheduleText",
        "notes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,80}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "lifecycle": {
          "type": "string",
          "enum": [
            "PLANNED",
            "PRE_DEVELOPMENT",
            "COMPLETED"
          ]
        },
        "province": {
          "type": "string",
          "maxLength": 80
        },
        "city": {
          "type": "string",
          "maxLength": 80
        },
        "county": {
          "type": "string",
          "maxLength": 80
        },
        "locationLabel": {
          "type": "string",
          "maxLength": 240
        },
        "adminCode": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 100000,
              "maximum": 999999
            },
            {
              "type": "null"
            }
          ]
        },
        "scheduleText": {
          "type": "string",
          "maxLength": 400
        },
        "notes": {
          "type": "string",
          "maxLength": 1000
        }
      }
    },
    "InventoryAssetInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assetDeviceId",
        "projectId",
        "displayName",
        "craneModel",
        "ratedCapacityT",
        "spanM",
        "workClass",
        "grabType",
        "lifecycle"
      ],
      "properties": {
        "assetDeviceId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,80}$"
        },
        "projectId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,80}$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "craneModel": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 160
            },
            {
              "type": "null"
            }
          ]
        },
        "ratedCapacityT": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "spanM": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "workClass": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 80
            },
            {
              "type": "null"
            }
          ]
        },
        "grabType": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 160
            },
            {
              "type": "null"
            }
          ]
        },
        "lifecycle": {
          "type": "string",
          "enum": [
            "PLANNED",
            "PRE_DEVELOPMENT",
            "COMPLETED"
          ]
        }
      }
    },
    "RuntimeDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtimeDeviceId",
        "projectId",
        "assetDeviceId",
        "sourceMode"
      ],
      "properties": {
        "runtimeDeviceId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,80}$"
        },
        "projectId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,80}$"
        },
        "assetDeviceId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,80}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceMode": {
          "type": "string",
          "enum": [
            "SIMULATION",
            "REAL",
            "TEST"
          ]
        }
      }
    }
  }
}
