{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.invalid/crane/v1/operationsreviewasset.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "assetStatus",
    "alarm"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "assetStatus": {
      "type": "string",
      "enum": [
        "DRAFT",
        "OUT_OF_SERVICE"
      ]
    },
    "alarm": {
      "type": "boolean"
    }
  },
  "$defs": {}
}
