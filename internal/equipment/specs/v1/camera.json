{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.invalid/crane/v1/equipment-spec/1/camera.json",
  "title": "Camera specification v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "camera_type": {"type": "string", "enum": ["RGB", "DEPTH", "STEREO", "THERMAL", "INDUSTRIAL"]},
    "resolution_width": {"type": "integer", "minimum": 1},
    "resolution_height": {"type": "integer", "minimum": 1},
    "max_fps": {"type": "number", "minimum": 0},
    "sensor_model": {"type": "string"},
    "sensor_type": {"type": "string"},
    "pixel_size_um": {"type": "number", "minimum": 0},
    "lens_model": {"type": "string"},
    "focal_length_mm": {"type": "number", "minimum": 0},
    "horizontal_fov_deg": {"type": "number", "minimum": 0},
    "vertical_fov_deg": {"type": "number", "minimum": 0},
    "interface_type": {"type": "string", "enum": ["GigE", "PoE", "USB3", "MIPI", "OTHER"]},
    "protocol": {"type": "string", "enum": ["RTSP", "ONVIF", "VENDOR_SDK"]},
    "poe_required": {"type": "boolean"},
    "firmware_version": {"type": "string"}
  }
}
