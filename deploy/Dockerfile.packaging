# Local Windows packaging only; CI builds from source with Dockerfile.backend.
FROM alpine:3.23@sha256:ff7f0c727dd796aa36787bfcd9a64bf35a6ce72a73451b3359fde849b6703d63
RUN apk add --no-cache ca-certificates && addgroup -g 10001 app && adduser -D -u 10001 -G app app
ARG EXECUTABLE
COPY --chmod=0755 ${EXECUTABLE} /usr/local/bin/service
USER 10001:10001
ENTRYPOINT ["/usr/local/bin/service"]
