# Include once inside shared Nginx http {}, e.g. conf.d/00-baobei-common.conf.
# Only the shared ingress joins u-dao-baobei-frontend; do not join Crane services to it.
limit_req_zone $binary_remote_addr zone=baobei_ingress_login:1m rate=12r/m;
limit_req_zone $binary_remote_addr zone=baobei_ingress_callback:1m rate=24r/m;
