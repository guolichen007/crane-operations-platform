# Include inside shared Nginx http {} after baobei-http-common.conf.example.
server {
    listen 80;
    server_name baobei.youdaozd.com;
    resolver 127.0.0.11 valid=10s ipv6=off;
    resolver_timeout 5s;
    access_log off;
    error_log /dev/stderr crit;
    set $baobei_web http://baobei-web:8080;
    location ^~ /.well-known/acme-challenge/ {
        # No upstream URI: forward the original token path and query intact.
        proxy_pass $baobei_web;
        proxy_http_version 1.1;
        proxy_pass_request_headers off;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Connection "";
        proxy_set_header Host baobei.youdaozd.com;
        proxy_set_header X-Forwarded-Proto http;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_connect_timeout 5s;
        proxy_send_timeout 5s;
        proxy_read_timeout 5s;
        proxy_cache off;
        proxy_intercept_errors off;
    }
    # An exact match avoids Nginx's implicit slash redirect on proxy locations.
    location = /.well-known/acme-challenge { return 308 https://baobei.youdaozd.com$request_uri; }
    location / { return 308 https://baobei.youdaozd.com$request_uri; }
}
server {
    listen 443 ssl;
    server_name baobei.youdaozd.com;
    resolver 127.0.0.11 valid=10s ipv6=off;
    resolver_timeout 5s;
    ssl_certificate /etc/nginx/tls/baobei/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/baobei/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log off;
    error_log /dev/stderr crit;
    client_max_body_size 64k;
    # Variable + Docker DNS avoids a pinned container IP and startup DNS lookup.
    set $baobei_web http://baobei-web:8080;
    proxy_http_version 1.1;
    proxy_set_header Host baobei.youdaozd.com;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Connection "";
    proxy_connect_timeout 5s;
    proxy_read_timeout 30s;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    location = /auth/login {
        limit_req zone=baobei_ingress_login burst=8 nodelay;
        limit_req_status 429;
        proxy_pass $baobei_web;
    }
    location = /auth/callback {
        limit_req zone=baobei_ingress_callback burst=12 nodelay;
        limit_req_status 429;
        proxy_pass $baobei_web;
    }
    location / { proxy_pass $baobei_web; }
}
