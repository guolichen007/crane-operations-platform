[Unit]
Description=U-Dao Baobei guarded certificate renewal
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
Environment=ACME_PACKAGED=1
Environment=AUTO_UPGRADE=0
ExecStart=/usr/local/sbin/u-dao-baobei-cert-renew --run
TimeoutStartSec=30min
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/u-dao/secrets/baobei/acme /srv/u-dao/platform/ingress/acme-webroot
ReadWritePaths=-/srv/u-dao/platform/ingress/tls/baobei
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
