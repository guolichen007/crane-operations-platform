FROM node:24.19.0-alpine@sha256:d32cdf619f63fe0471182d08996dd516c6275bb5fd31ae06e55a570bd9e1ad43 AS build
WORKDIR /src
COPY package.json package-lock.json ./
COPY apps/web-console/package.json apps/web-console/package.json
RUN npm ci
COPY apps/web-console apps/web-console
COPY contracts contracts
ENV VITE_DATA_MODE=api
RUN npm run build
FROM nginx:1.28-alpine@sha256:a8b39bd9cf0f83869a2162827a0caf6137ddf759d50a171451b335cecc87d236
COPY deploy/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/apps/web-console/dist /usr/share/nginx/html
