# Fill image references from the reviewed release-manifest.json. Never use latest or a mutable tag.
CRANE_CLOUD_IMAGE=
CRANE_WEB_IMAGE=
CRANE_PUBLIC_URL=https://crane.youdaozd.com
CRANE_AUTH_URL=https://crane.youdaozd.com
CRANE_FRONTEND_NETWORK=u-dao-crane-frontend
# Exact owned proxy/network CIDRs, never 0.0.0.0/0. Discover and review before deployment.
CRANE_PROXY_CIDRS=
CRANE_WEB_PORT=18081
CRANE_AUTH_PORT=18082
CRANE_SECRET_DIR=/srv/u-dao/secrets/crane-ops
CRANE_INVENTORY_FILE=/srv/u-dao/secrets/crane-ops/inventory.json
CRANE_FLEET_FILE=/srv/u-dao/secrets/crane-ops/fleet.json
CRANE_MQTT_DIR=/srv/u-dao/secrets/crane-ops/mqtt
CRANE_MQTT_ACL=/srv/u-dao/secrets/crane-ops/acl
# Existing backup directory; preflight checks its filesystem independently from DockerRootDir.
CRANE_BACKUP_ROOT=/srv/u-dao/backups/crane-ops
# Optional assertion only; must match docker info and cannot override the actual data-root.
CRANE_DOCKER_ROOT_DIR=
