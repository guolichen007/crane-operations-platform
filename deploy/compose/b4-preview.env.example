# B4 Preview 隔离环境变量示例。绝不复用 production 的值。
# 镜像：固定到不可变 digest，禁止 latest。digest 取自该固定 SHA 对应的
# 生产候选发布产物（production-release 的 release-manifest.json artifact），
# 而非仓库内路径（仓库不提交 release 产物）。部署前由 OWNER 提供对应 SHA 的
# cloud-api/web-console `image@sha256`，并以 trivy/SBOM 复核。
CRANE_CLOUD_IMAGE=<cloud-api@sha256:...>
CRANE_WEB_IMAGE=<web-console@sha256:...>

# 独立 Preview 域名；端口与既有基座一致（web 18083 / auth 18085）。
CRANE_PUBLIC_URL=https://b4.crane.youdaozd.com
CRANE_AUTH_URL=https://b4.crane.youdaozd.com
CRANE_WEB_PORT=18083
CRANE_AUTH_PORT=18085

# 独立前端网络（与 production 的 u-dao-crane-frontend 分离）。
CRANE_FRONTEND_NETWORK=u-dao-crane-b4-preview-frontend

# 预留 Preview 子网 10.240.40.0/24 的受信 ingress CIDR（部署前 CC 复核，禁止 0.0.0.0/0）。
CRANE_PROXY_CIDRS=10.240.40.0/24

# 独立 secrets / 数据目录，绝不指向 production 目录。
CRANE_SECRET_DIR=/srv/u-dao/secrets/crane-b4-preview
CRANE_INVENTORY_FILE=/srv/u-dao/secrets/crane-b4-preview/inventory.json
CRANE_FLEET_FILE=/srv/u-dao/secrets/crane-b4-preview/fleet.json
CRANE_MQTT_DIR=/srv/u-dao/secrets/crane-b4-preview/mqtt
CRANE_MQTT_ACL=/srv/u-dao/secrets/crane-b4-preview/acl

# 会话（与 production 策略一致）。
CRANE_SESSION_ABSOLUTE_SECONDS=28800
CRANE_SESSION_IDLE_SECONDS=1800
